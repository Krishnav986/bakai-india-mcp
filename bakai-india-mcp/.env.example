# =====================================================================
# BAKAI INDIA MCP SERVER ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Identification
MCP_SERVER_NAME=bakai-india-mcp
MCP_SERVER_VERSION=1.0.0
LOG_LEVEL=INFO

# Network Timeouts
REQUEST_TIMEOUT_SECONDS=8.0
RADIO_STREAM_TIMEOUT_SECONDS=4.0
CACHE_DEFAULT_TTL_SECONDS=300

# Robot Spoken Defaults
DEFAULT_SPEECH_LANGUAGE=hi
VOICE_PERSONALITY_NAME=BAKAI

# ---------------------------------------------------------------------
# Xiaozhi Robot Cloud & WebSocket MCP Integration
# ---------------------------------------------------------------------
# Set to your Xiaozhi WebSocket server endpoint (official cloud or self-hosted)
XIAOZHI_WS_ENDPOINT=wss://api.xiaozhi.me/v1/mcp
# Device token provided in your Xiaozhi console
XIAOZHI_TOKEN=your_xiaozhi_device_token_here
# Device identifier
XIAOZHI_DEVICE_ID=bakai_robot_01

# ---------------------------------------------------------------------
# Optional API integrations
# ---------------------------------------------------------------------
# Existing news, weather, radio, and web-search tools have public fallbacks.
# Some new tools require provider keys or partner access; they report this clearly
# when the corresponding credentials are not configured.

# Google YouTube Data API v3 (for official YouTube API search quota)
YOUTUBE_API_KEY=

# Spotify Developer API (for direct Spotify catalog search)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Tavily AI Search (for deep web scraping and research)
TAVILY_API_KEY=

# OpenWeatherMap API (optional alternative to default Open-Meteo)
OPENWEATHER_API_KEY=

# NewsAPI (optional alternative to default The Hindu & Sentinel Assam RSS)
NEWS_API_KEY=

# ---------------------------------------------------------------------
# Optional new live-data integrations
# ---------------------------------------------------------------------
# API-Sports Cricket (live scores and schedules; x-apisports-key)
CRICKET_API_KEY=your_api_sports_cricket_key_here

# Amadeus for Developers (production flight-offer search; never books)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here

# Aviationstack (live flight status)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Google Maps Routes API (directions, traffic-aware durations, transit routes)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Calendarific holiday calendar
CALENDARIFIC_API_KEY=your_calendarific_api_key_here

# Metals-API (INR spot gold quote)
METALS_API_KEY=your_metals_api_key_here

# N2YO (ISS position; free account API key)
N2YO_API_KEY=your_n2yo_api_key_here
